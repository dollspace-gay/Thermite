fn atomic_storage_capacity_probe(
  width: u8,
  capacity: usize,
) -> bool
  req true
  ens result == atomic_init_capacity_legal_spec(width, capacity)
  fx pure
{
  atomic_init_capacity_probe(width, capacity)
}

fn atomic_bool_region_init(
  region: StaticStorageRegion,
  authority: usize,
  storage_slot: usize,
  generation: u64,
  initial: bool,
) -> bool
  req static_storage_region_authority_spec(&region) == authority
    && static_storage_region_slot_spec(&region) == storage_slot
    && static_storage_region_generation_spec(&region) == generation
    && static_storage_region_capacity_spec(&region) >= ATOMIC_BOOL_STORAGE_BYTES
  ens result
  fx platform(atomic)
{
  let slot: AtomicBoolSlot = atomic_bool_slot_from_region(region);
  let cell: AtomicBool = atomic_bool_init(slot, initial);
  atomic_identity_matches_values(
    &cell.identity,
    authority,
    storage_slot,
    generation,
  )
}

