struct BarrierState64 {
  registered: u64,
  arrived: u64,
  generation: u64,
}

enum BarrierRegister64 {
  BarrierRegistered64 {
    barrier: BarrierState64,
    participant: u64,
  },
  BarrierAlreadyRegistered64 {
    barrier: BarrierState64,
    participant: u64,
  },
  BarrierRegisterRoundInProgress64 {
    barrier: BarrierState64,
    participant: u64,
  },
}

enum BarrierUnregister64 {
  BarrierUnregistered64 {
    barrier: BarrierState64,
    participant: u64,
  },
  BarrierNotRegistered64 {
    barrier: BarrierState64,
    participant: u64,
  },
  BarrierUnregisterRoundInProgress64 {
    barrier: BarrierState64,
    participant: u64,
  },
}

enum BarrierArrive64 {
  BarrierWaiting64 {
    barrier: BarrierState64,
    participant: u64,
    generation: u64,
  },
  BarrierAdvanced64 {
    barrier: BarrierState64,
    participant: u64,
    completed_generation: u64,
  },
  BarrierStaleGeneration64 {
    barrier: BarrierState64,
    participant: u64,
    generation: u64,
  },
  BarrierInactiveParticipant64 {
    barrier: BarrierState64,
    participant: u64,
    generation: u64,
  },
  BarrierDuplicateArrival64 {
    barrier: BarrierState64,
    participant: u64,
    generation: u64,
  },
  BarrierGenerationExhausted64 {
    barrier: BarrierState64,
    participant: u64,
    generation: u64,
  },
}

fn barrier_membership_mask_valid(participant: u64) -> bool
  req true
  ens result == (participant != 0)
  fx pure
{
  participant != 0
}

fn barrier_wf(barrier: &BarrierState64) -> bool
  req true
  ens result == ((barrier.arrived & barrier.registered) == barrier.arrived)
  fx pure
{
  (barrier.arrived & barrier.registered) == barrier.arrived
}

fn barrier_empty() -> BarrierState64
  req true
  ens result.registered == 0
  ens result.arrived == 0
  ens result.generation == 0
  fx pure
{
  BarrierState64 {
    registered: 0,
    arrived: 0,
    generation: 0,
  }
}

fn barrier_is_registered(
  barrier: &BarrierState64,
  participant: u64,
) -> bool
  req participant != 0
  ens result == ((barrier.registered & participant) != 0)
  fx pure
{
  (barrier.registered & participant) != 0
}

fn barrier_has_arrived(
  barrier: &BarrierState64,
  participant: u64,
) -> bool
  req participant != 0
  ens result == ((barrier.arrived & participant) != 0)
  fx pure
{
  (barrier.arrived & participant) != 0
}

fn barrier_register(
  barrier: BarrierState64,
  participant: u64,
) -> BarrierRegister64
  req participant != 0
  ens match result {
    BarrierRegister64::BarrierRegistered64 {
      barrier: next,
      participant: returned,
    } =>
      barrier.arrived == 0
        && (barrier.registered & participant) == 0
        && next.registered == (barrier.registered | participant)
        && next.arrived == 0
        && next.generation == barrier.generation
        && returned == participant,
    BarrierRegister64::BarrierAlreadyRegistered64 {
      barrier: next,
      participant: returned,
    } =>
      barrier.arrived == 0
        && (barrier.registered & participant) != 0
        && next.registered == barrier.registered
        && next.arrived == barrier.arrived
        && next.generation == barrier.generation
        && returned == participant,
    BarrierRegister64::BarrierRegisterRoundInProgress64 {
      barrier: next,
      participant: returned,
    } =>
      barrier.arrived != 0
        && next.registered == barrier.registered
        && next.arrived == barrier.arrived
        && next.generation == barrier.generation
        && returned == participant,
  }
  fx pure
{
  if barrier.arrived != 0 {
    BarrierRegister64::BarrierRegisterRoundInProgress64 {
      barrier: barrier,
      participant: participant,
    }
  } else {
    if (barrier.registered & participant) != 0 {
      BarrierRegister64::BarrierAlreadyRegistered64 {
        barrier: barrier,
        participant: participant,
      }
    } else {
      BarrierRegister64::BarrierRegistered64 {
        barrier: BarrierState64 {
          registered: barrier.registered | participant,
          arrived: 0,
          generation: barrier.generation,
        },
        participant: participant,
      }
    }
  }
}

fn barrier_unregister(
  barrier: BarrierState64,
  participant: u64,
) -> BarrierUnregister64
  req participant != 0
  ens match result {
    BarrierUnregister64::BarrierUnregistered64 {
      barrier: next,
      participant: returned,
    } =>
      barrier.arrived == 0
        && (barrier.registered & participant) != 0
        && next.registered == (barrier.registered ^ participant)
        && next.arrived == 0
        && next.generation == barrier.generation
        && returned == participant,
    BarrierUnregister64::BarrierNotRegistered64 {
      barrier: next,
      participant: returned,
    } =>
      barrier.arrived == 0
        && (barrier.registered & participant) == 0
        && next.registered == barrier.registered
        && next.arrived == barrier.arrived
        && next.generation == barrier.generation
        && returned == participant,
    BarrierUnregister64::BarrierUnregisterRoundInProgress64 {
      barrier: next,
      participant: returned,
    } =>
      barrier.arrived != 0
        && next.registered == barrier.registered
        && next.arrived == barrier.arrived
        && next.generation == barrier.generation
        && returned == participant,
  }
  fx pure
{
  if barrier.arrived != 0 {
    BarrierUnregister64::BarrierUnregisterRoundInProgress64 {
      barrier: barrier,
      participant: participant,
    }
  } else {
    if (barrier.registered & participant) == 0 {
      BarrierUnregister64::BarrierNotRegistered64 {
        barrier: barrier,
        participant: participant,
      }
    } else {
      BarrierUnregister64::BarrierUnregistered64 {
        barrier: BarrierState64 {
          registered: barrier.registered ^ participant,
          arrived: 0,
          generation: barrier.generation,
        },
        participant: participant,
      }
    }
  }
}

fn barrier_arrive(
  barrier: BarrierState64,
  participant: u64,
  generation: u64,
) -> BarrierArrive64
  req participant != 0
  ens match result {
    BarrierArrive64::BarrierWaiting64 {
      barrier: next,
      participant: returned,
      generation: returned_generation,
    } =>
      generation == barrier.generation
        && (barrier.registered & participant) != 0
        && (barrier.arrived & participant) == 0
        && barrier.generation < u64::MAX
        && next.registered == barrier.registered
        && next.arrived == (barrier.arrived | participant)
        && next.arrived != next.registered
        && next.generation == barrier.generation
        && returned == participant
        && returned_generation == generation,
    BarrierArrive64::BarrierAdvanced64 {
      barrier: next,
      participant: returned,
      completed_generation,
    } =>
      generation == barrier.generation
        && (barrier.registered & participant) != 0
        && (barrier.arrived & participant) == 0
        && barrier.generation < u64::MAX
        && (barrier.arrived | participant) == barrier.registered
        && next.registered == barrier.registered
        && next.arrived == 0
        && next.generation == barrier.generation + 1
        && returned == participant
        && completed_generation == generation,
    BarrierArrive64::BarrierStaleGeneration64 {
      barrier: next,
      participant: returned,
      generation: returned_generation,
    } =>
      generation != barrier.generation
        && next.registered == barrier.registered
        && next.arrived == barrier.arrived
        && next.generation == barrier.generation
        && returned == participant
        && returned_generation == generation,
    BarrierArrive64::BarrierInactiveParticipant64 {
      barrier: next,
      participant: returned,
      generation: returned_generation,
    } =>
      generation == barrier.generation
        && (barrier.registered & participant) == 0
        && next.registered == barrier.registered
        && next.arrived == barrier.arrived
        && next.generation == barrier.generation
        && returned == participant
        && returned_generation == generation,
    BarrierArrive64::BarrierDuplicateArrival64 {
      barrier: next,
      participant: returned,
      generation: returned_generation,
    } =>
      generation == barrier.generation
        && (barrier.registered & participant) != 0
        && (barrier.arrived & participant) != 0
        && next.registered == barrier.registered
        && next.arrived == barrier.arrived
        && next.generation == barrier.generation
        && returned == participant
        && returned_generation == generation,
    BarrierArrive64::BarrierGenerationExhausted64 {
      barrier: next,
      participant: returned,
      generation: returned_generation,
    } =>
      generation == barrier.generation
        && (barrier.registered & participant) != 0
        && (barrier.arrived & participant) == 0
        && barrier.generation == u64::MAX
        && next.registered == barrier.registered
        && next.arrived == barrier.arrived
        && next.generation == barrier.generation
        && returned == participant
        && returned_generation == generation,
  }
  fx pure
{
  if generation != barrier.generation {
    BarrierArrive64::BarrierStaleGeneration64 {
      barrier: barrier,
      participant: participant,
      generation: generation,
    }
  } else {
    if (barrier.registered & participant) == 0 {
      BarrierArrive64::BarrierInactiveParticipant64 {
        barrier: barrier,
        participant: participant,
        generation: generation,
      }
    } else {
      if (barrier.arrived & participant) != 0 {
        BarrierArrive64::BarrierDuplicateArrival64 {
          barrier: barrier,
          participant: participant,
          generation: generation,
        }
      } else {
        if barrier.generation == u64::MAX {
          BarrierArrive64::BarrierGenerationExhausted64 {
            barrier: barrier,
            participant: participant,
            generation: generation,
          }
        } else {
          let arrived: u64 = barrier.arrived | participant;
          if arrived == barrier.registered {
            BarrierArrive64::BarrierAdvanced64 {
              barrier: BarrierState64 {
                registered: barrier.registered,
                arrived: 0,
                generation: barrier.generation + 1,
              },
              participant: participant,
              completed_generation: generation,
            }
          } else {
            BarrierArrive64::BarrierWaiting64 {
              barrier: BarrierState64 {
                registered: barrier.registered,
                arrived: arrived,
                generation: barrier.generation,
              },
              participant: participant,
              generation: generation,
            }
          }
        }
      }
    }
  }
}

fn barrier_stale_generation_probe() -> bool
  req true
  ens result
  fx pure
{
  let active: BarrierState64 = BarrierState64 {
    registered: 1,
    arrived: 0,
    generation: 7,
  };
  match barrier_arrive(active, 1, 6) {
    BarrierArrive64::BarrierWaiting64 { barrier: _, participant: _, generation: _ } => false,
    BarrierArrive64::BarrierAdvanced64 { barrier: _, participant: _, completed_generation: _ } => false,
    BarrierArrive64::BarrierStaleGeneration64 { barrier, participant, generation } =>
      participant == 1
        && generation == 6
        && barrier.registered == 1
        && barrier.arrived == 0
        && barrier.generation == 7,
    BarrierArrive64::BarrierInactiveParticipant64 { barrier: _, participant: _, generation: _ } => false,
    BarrierArrive64::BarrierDuplicateArrival64 { barrier: _, participant: _, generation: _ } => false,
    BarrierArrive64::BarrierGenerationExhausted64 { barrier: _, participant: _, generation: _ } => false,
  }
}

fn barrier_membership_freeze_probe() -> bool
  req true
  ens result
  fx pure
{
  let waiting: BarrierState64 = BarrierState64 {
    registered: 3,
    arrived: 1,
    generation: 9,
  };
  match barrier_register(waiting, 4) {
    BarrierRegister64::BarrierRegistered64 { barrier: _, participant: _ } => false,
    BarrierRegister64::BarrierAlreadyRegistered64 { barrier: _, participant: _ } => false,
    BarrierRegister64::BarrierRegisterRoundInProgress64 { barrier, participant } =>
      participant == 4
        && barrier.registered == 3
        && barrier.arrived == 1
        && barrier.generation == 9,
  }
}

fn barrier_arrival_classify(
  same_generation: bool,
  active: bool,
  duplicate: bool,
  generation_available: bool,
  completes: bool,
) -> u8
  req true
  ens result <= 5
  ens same_generation || result == 0
  ens !same_generation || active || result == 1
  ens !same_generation || !active || !duplicate || result == 2
  ens !same_generation || !active || duplicate || generation_available || result == 3
  ens !same_generation || !active || duplicate || !generation_available || !completes || result == 4
  ens !same_generation || !active || duplicate || !generation_available || completes || result == 5
  fx pure
{
  if !same_generation {
    0
  } else {
    if !active {
      1
    } else {
      if duplicate {
        2
      } else {
        if !generation_available {
          3
        } else {
          if completes {
            4
          } else {
            5
          }
        }
      }
    }
  }
}

fn barrier_classification_probe() -> bool
  req true
  ens result
  fx pure
{
  barrier_arrival_classify(false, true, true, true, true) == 0
    && barrier_arrival_classify(true, false, true, true, true) == 1
    && barrier_arrival_classify(true, true, true, true, true) == 2
    && barrier_arrival_classify(true, true, false, false, true) == 3
    && barrier_arrival_classify(true, true, false, true, true) == 4
    && barrier_arrival_classify(true, true, false, true, false) == 5
}

fn barrier_generation_next(generation: u64) -> Option<u64>
  req true
  ens match result {
    Some(next) => generation < u64::MAX && next == generation + 1,
    None => generation == u64::MAX,
  }
  fx pure
{
  if generation == u64::MAX {
    None
  } else {
    Some(generation + 1)
  }
}

fn barrier_generation_exhaustion_probe() -> bool
  req true
  ens result
  fx pure
{
  match barrier_generation_next(u64::MAX) {
    Some(next) => next == 0,
    None => true,
  }
}
