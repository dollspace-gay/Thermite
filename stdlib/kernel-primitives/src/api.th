fn atomic_bool_store(cell: &AtomicBool, value: bool, order: AtomicOrdering) -> AtomicWrite
  req atomic_store_order_legal_spec(order)
  ens atomic_identity_eq_spec(&result.cell, &cell.identity) && result.width == 0
    && result.order == atomic_order_code(order) && result.value == value as u64
  fx platform(atomic)
{
  let stored: bool = atomic_machine_bool_store(cell.machine_handle, value, atomic_order_to_code(&order)).0;
  AtomicWrite {
    cell: atomic_identity_copy(&cell.identity),
    width: 0,
    order: atomic_order_to_code(&order),
    value: stored as u64,
  }
}

