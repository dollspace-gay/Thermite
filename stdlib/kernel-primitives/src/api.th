fn atomic_compiler_fence(order: AtomicOrdering) -> AtomicFence
  req atomic_fence_order_legal_spec(order)
  ens result.kind == 0 && result.order == atomic_order_code(order)
  fx platform(atomic)
{
  let completed: bool = atomic_machine_compiler_fence(atomic_order_to_code(&order));
  AtomicFence { kind: if completed { 0 } else { 1 }, order: atomic_order_to_code(&order) }
}

fn atomic_hardware_fence(order: AtomicOrdering) -> AtomicFence
  req atomic_fence_order_legal_spec(order)
  ens result.kind == 1 && result.order == atomic_order_code(order)
  fx platform(atomic)
{
  let completed: bool = atomic_machine_hardware_fence(atomic_order_to_code(&order));
  AtomicFence { kind: if completed { 1 } else { 0 }, order: atomic_order_to_code(&order) }
}

fn atomic_load_order_probe(order: AtomicOrdering) -> bool
  req true
  ens result == atomic_load_order_legal_spec(order)
  fx pure
{
  atomic_load_order_legal(order)
}

fn atomic_cas_order_probe(success: AtomicOrdering, failure: AtomicOrdering) -> bool
  req true
  ens result == atomic_cas_order_legal_spec(success, failure)
  fx pure
{
  atomic_cas_order_legal(success, failure)
}

fn atomic_happens_before_probe(history: &AtomicHistory, event: usize) -> bool
  req event > 0 && event <= history.len
  ens result && atomic_happens_before(history, event, event, history.len)
  fx pure
{
  atomic_happens_before_reflexive(history, event)
}

fn atomic_ordering_matrix_probe(case: u8) -> bool
  req case < 45
  ens result == atomic_ordering_matrix_spec(case)
  fx pure
{
  (case < 5 && atomic_load_code_legal(case))
    || (case >= 5 && case < 10 && atomic_store_code_legal((case - 5) as u8))
    || (case >= 10 && case < 15 && atomic_fence_code_legal((case - 10) as u8))
    || (case >= 15 && case < 40 && atomic_cas_code_legal(
      ((case - 15) / 5) as u8,
      ((case - 15) % 5) as u8,
    ))
    || (case >= 40 && atomic_rmw_code_legal((case - 40) as u8))
}

fn atomic_history_model_probe(
  program_parent: &[usize; ATOMIC_HISTORY_CAPACITY],
  synchronize_parent: &[usize; ATOMIC_HISTORY_CAPACITY],
  release_parent: &[usize; ATOMIC_HISTORY_CAPACITY],
  len: usize,
  event: usize,
) -> bool
  req len <= ATOMIC_HISTORY_CAPACITY && event > 0 && event <= len
  ens result
    && atomic_happens_before_edges(
      program_parent,
      synchronize_parent,
      len,
      event,
      event,
      len,
    )
    && atomic_release_sequence_edges(
      release_parent,
      len,
      event,
      event,
      len,
    )
  fx pure
{
  true
}
