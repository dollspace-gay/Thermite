fn atomic_bool_fetch_and(cell: &AtomicBool, value: bool, order: AtomicOrdering) -> AtomicBoolTransition
  req atomic_rmw_order_legal_spec(order)
  ens atomic_identity_eq_spec(&result.cell, &cell.identity) && result.next == (result.previous && value)
    && result.exchanged && result.success_order == atomic_order_code(order)
  fx platform(atomic)
{
  let previous: bool = atomic_machine_bool_fetch_and(cell.machine_handle, value, atomic_order_to_code(&order)).0;
  atomic_bool_rmw_result(cell, previous, previous && value, order)
}

fn atomic_bool_fetch_or(cell: &AtomicBool, value: bool, order: AtomicOrdering) -> AtomicBoolTransition
  req atomic_rmw_order_legal_spec(order)
  ens atomic_identity_eq_spec(&result.cell, &cell.identity) && result.next == (result.previous || value)
    && result.exchanged && result.success_order == atomic_order_code(order)
  fx platform(atomic)
{
  let previous: bool = atomic_machine_bool_fetch_or(cell.machine_handle, value, atomic_order_to_code(&order)).0;
  atomic_bool_rmw_result(cell, previous, previous || value, order)
}

fn atomic_bool_fetch_xor(cell: &AtomicBool, value: bool, order: AtomicOrdering) -> AtomicBoolTransition
  req atomic_rmw_order_legal_spec(order)
  ens atomic_identity_eq_spec(&result.cell, &cell.identity) && result.next == (result.previous != value)
    && result.exchanged && result.success_order == atomic_order_code(order)
  fx platform(atomic)
{
  let previous: bool = atomic_machine_bool_fetch_xor(cell.machine_handle, value, atomic_order_to_code(&order)).0;
  atomic_bool_rmw_result(cell, previous, previous != value, order)
}

fn atomic_u32_fetch_add(cell: &AtomicU32, value: u32, order: AtomicOrdering) -> AtomicU32Transition
  req atomic_rmw_order_legal_spec(order)
  ens atomic_identity_eq_spec(&result.cell, &cell.identity) && result.next == atomic_u32_wrapping_add(result.previous, value)
    && result.exchanged && result.success_order == atomic_order_code(order)
  fx platform(atomic)
