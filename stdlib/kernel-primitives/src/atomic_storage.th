fn atomic_u64_storage_lifecycle_probe(
  identity: usize,
  storage_slot: usize,
  capacity: usize,
  fill: u8,
  initial: u64,
) -> bool
  req storage_slot < STATIC_STORAGE_SLOT_COUNT
    && capacity >= ATOMIC_U64_STORAGE_BYTES
  ens result
  fx platform(boot), platform(memory), platform(atomic)
{
  let authority: StaticStorageAuthority = static_storage_authority(identity);
  let ledger: StaticStorageLedger = static_storage_ledger_init(authority);
  match static_storage_claim_at(ledger, storage_slot, capacity) {
    StaticStorageClaim::Claimed {
      ledger: claimed,
      lease,
    } => atomic_u64_storage_after_claim(
      claimed,
      lease,
      fill,
      initial,
    ),
    StaticStorageClaim::ClaimRejected {
      ledger: _,
      reason: _,
    } => false,
  }
}
