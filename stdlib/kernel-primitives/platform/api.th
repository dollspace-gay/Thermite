  ens result.domain == mapping.domain
    && result.generation == mapping.generation
    && result.device_address == mapping.device_address
    && result.length == mapping.length
  fx platform(dma);

#[boundary("thermite::clock::monotonic_read")]
fn clock_monotonic_read(clock: usize) -> ClockObservation
  req true
  ens result.clock == clock
  fx platform(clock);

#[boundary("thermite::clock::deadline_arm")]
fn clock_deadline_arm(clock: usize, deadline: u64) -> DeadlineReceipt
  req true
  ens result.clock == clock && result.deadline == deadline
  fx platform(clock);

#[boundary("thermite::clock::deadline_cancel")]
fn clock_deadline_cancel(clock: usize) -> DeadlineReceipt
  req true
  ens result.clock == clock && result.deadline == 0
  fx platform(clock);

#[boundary("thermite::entropy::fill")]
fn entropy_fill(permit: EntropyPermit, destination: RawAddress, length: usize) -> EntropyReceipt
  req raw_range_legal_spec(&destination, length)
  ens result.permit == permit.identity
    && result.generation == permit.generation
    && result.length == length
  fx platform(entropy);

#[boundary("thermite::power::reboot_terminal")]
fn power_reboot_terminal(permit: PowerPermit, reason: u64) -> TerminalReceipt
  req true
  ens result.identity == permit.identity && result.code == reason
  fx platform(power), diverge;

#[boundary("thermite::power::off_terminal")]
fn power_off_terminal(permit: PowerPermit, reason: u64) -> TerminalReceipt
  req true
  ens result.identity == permit.identity && result.code == reason
  fx platform(power), diverge;
