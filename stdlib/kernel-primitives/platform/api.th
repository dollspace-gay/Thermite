spec fn platform_width_legal_spec(width: u8) -> bool
  dec width
{
  width == 1 || width == 2 || width == 4 || width == 8
}

spec fn raw_range_legal_spec(address: &RawAddress, length: usize) -> bool
  dec length
{
  address.offset <= address.capacity
    && length <= address.capacity - address.offset
}

spec fn raw_aligned_spec(address: &RawAddress, width: u8) -> bool
  dec width
{
  platform_width_legal_spec(width)
    && address.offset % width as usize == 0
    && raw_range_legal_spec(address, width as usize)
}

spec fn mmio_range_legal_spec(address: &MmioAddress, length: usize) -> bool
  dec length
{
  address.offset <= address.capacity
    && length <= address.capacity - address.offset
}

spec fn mmio_aligned_spec(address: &MmioAddress, width: u8) -> bool
  dec width
{
  platform_width_legal_spec(width)
    && address.offset % width as usize == 0
    && mmio_range_legal_spec(address, width as usize)
}

fn platform_width_legal(width: u8) -> bool
  req true
  ens result == platform_width_legal_spec(width)
  fx pure
{
  width == 1 || width == 2 || width == 4 || width == 8
}

fn raw_range_legal(address: &RawAddress, length: usize) -> bool
  req true
  ens result == raw_range_legal_spec(address, length)
  fx pure
{
  address.offset <= address.capacity
    && length <= address.capacity - address.offset
}

fn raw_aligned(address: &RawAddress, width: u8) -> bool
  req true
  ens result == raw_aligned_spec(address, width)
  fx pure
{
  platform_width_legal(width)
    && address.offset % width as usize == 0
    && raw_range_legal(address, width as usize)
}

fn mmio_range_legal(address: &MmioAddress, length: usize) -> bool
  req true
  ens result == mmio_range_legal_spec(address, length)
  fx pure
{
  address.offset <= address.capacity
    && length <= address.capacity - address.offset
}

fn mmio_aligned(address: &MmioAddress, width: u8) -> bool
  req true
  ens result == mmio_aligned_spec(address, width)
  fx pure
{
  platform_width_legal(width)
    && address.offset % width as usize == 0
    && mmio_range_legal(address, width as usize)
}

#[boundary("thermite::boot::normalize_handoff")]
fn boot_handoff_normalize(raw: usize, length: usize) -> BootHandoff
  req length > 0
  ens result.identity == raw && result.length == length
  fx platform(boot);

#[boundary("thermite::boot::entry_transfer")]
fn boot_entry_transfer(handoff: BootHandoff, permit: EntryPermit) -> TerminalReceipt
  req handoff.length > 0
  ens result.identity == permit.identity && result.code == handoff.identity as u64
  fx platform(boot), diverge;

#[boundary("thermite::runtime::panic_terminal")]
fn runtime_panic_terminal(permit: EntryPermit, code: u64) -> TerminalReceipt
  req true
  ens result.identity == permit.identity && result.code == code
  fx platform(boot), diverge;

#[boundary("thermite::runtime::contract_failure_terminal")]
fn runtime_contract_failure_terminal(permit: EntryPermit, code: u64) -> TerminalReceipt
