fn atomic_bool_load(cell: &AtomicBool, order: AtomicOrdering) -> AtomicBoolObservation
  req atomic_load_order_legal_spec(order)
  ens atomic_identity_eq_spec(&result.cell, &cell.identity) && result.order == atomic_order_code(order)
  fx platform(atomic)
{
  AtomicBoolObservation {
    value: atomic_machine_bool_load(cell.machine_handle, atomic_order_to_code(&order)).0,
    cell: atomic_identity_copy(&cell.identity),
    order: atomic_order_to_code(&order),
  }
}

