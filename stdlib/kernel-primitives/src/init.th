fn atomic_init_capacity_probe(
  width: u8,
  capacity: usize,
) -> bool
  req true
  ens result == atomic_init_capacity_legal_spec(width, capacity)
  fx pure
{
  atomic_init_capacity_legal(width, capacity)
}
