#[opaque] struct MutableCallState {
  value: u64,
  guard: u64,
}

spec fn mutable_call_value_spec(state: MutableCallState) -> u64
  dec 0
{
  state.value
}

spec fn mutable_call_guard_spec(state: MutableCallState) -> u64
  dec 0
{
  state.guard
}

fn mutable_call_new(value: u64, guard: u64) -> MutableCallState
  req true
  ens mutable_call_value_spec(result) == value
  ens mutable_call_guard_spec(result) == guard
  fx pure
{
  MutableCallState { value: value, guard: guard }
}

fn mutable_call_value(state: &MutableCallState) -> u64
  req true
  ens result == mutable_call_value_spec(*state)
  fx pure
{
  state.value
}

fn mutable_call_guard(state: &MutableCallState) -> u64
  req true
  ens result == mutable_call_guard_spec(*state)
  fx pure
{
  state.guard
}

fn mutable_call_set(state: &mut MutableCallState, next: u64) -> u64
  req true
  ens result == next
  ens mutable_call_value_spec(*final(state)) == next
  ens mutable_call_guard_spec(*final(state)) == mutable_call_guard_spec(*old(state))
  fx pure
{
  state.value = next;
  next
}

fn mutable_call_copy(state: &mut MutableCallState, source: &MutableCallState) -> u64
  req true
  ens result == mutable_call_value_spec(*source)
  ens mutable_call_value_spec(*final(state)) == mutable_call_value_spec(*source)
  ens mutable_call_guard_spec(*final(state)) == mutable_call_guard_spec(*old(state))
  fx pure
{
  state.value = source.value;
  source.value
}

fn mutable_call_pipeline(state: &mut MutableCallState, source: &MutableCallState) -> u64
  req true
  ens result == mutable_call_value_spec(*source)
  ens mutable_call_value_spec(*final(state)) == result
  ens mutable_call_guard_spec(*final(state)) == mutable_call_guard_spec(*old(state))
  fx pure
{
  let initial: u64 = mutable_call_value(source);
  let first: u64 = mutable_call_copy(state, source);
  let final_value: u64 = mutable_call_set(state, first);
  final_value
}
