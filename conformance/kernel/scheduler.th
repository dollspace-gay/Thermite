struct SchedulerState {
  cpu_count: u64,
  runnable_task: u64,
  current_task: u64,
  current_cpu: u64,
  dispatches: u64
}

fn scheduler_seed(cpu_count: u64, task: u64) -> SchedulerState
  req cpu_count > 0 && cpu_count <= 8 && task > 0 && task <= 1000
  ens result.cpu_count == cpu_count
  ens result.runnable_task == task
  ens result.current_task == 0
  ens result.current_cpu == 0
  ens result.dispatches == 0
  fx pure
{
  SchedulerState {
    cpu_count: cpu_count,
    runnable_task: task,
    current_task: 0,
    current_cpu: 0,
    dispatches: 0
  }
}

fn scheduler_dispatch(state: SchedulerState, cpu: u64) -> SchedulerState
  req state.cpu_count > 0 && state.cpu_count <= 8 && cpu < state.cpu_count && state.runnable_task > 0 && state.runnable_task <= 1000 && state.current_task == 0 && state.dispatches < 18446744073709551615
  ens result.cpu_count == state.cpu_count
  ens result.runnable_task == 0
  ens result.current_task == state.runnable_task
  ens result.current_cpu == cpu
  ens result.dispatches == state.dispatches + 1
  fx pure
{
  SchedulerState {
    cpu_count: state.cpu_count,
    runnable_task: 0,
    current_task: state.runnable_task,
    current_cpu: cpu,
    dispatches: state.dispatches + 1
  }
}

fn scheduler_bootstrap(cpu_count: u64) -> SchedulerState
  req cpu_count > 0 && cpu_count <= 8
  ens result.cpu_count == cpu_count
  ens result.runnable_task == 41
  ens result.current_task == 0
  ens result.current_cpu == 0
  ens result.dispatches == 0
  fx pure
{
  let synchronization_epoch: u64 = synchronization_bootstrap();
  scheduler_seed(cpu_count, 40 + synchronization_epoch)
}

fn scheduler_task_value(task_base: u64, task_index: u64) -> u64
  req task_base > 0 && task_base <= 1000 && task_index < 4096
  ens result == task_base + task_index
  fx pure
{
  task_base + task_index
}

fn scheduler_task_available(task_index: u64) -> bool
  req true
  ens result == (task_index < 4096)
  fx pure
{
  task_index < 4096
}

fn scheduler_seed_admitted(seed_index: u64, expected_workers: u64) -> bool
  req expected_workers > 0 && expected_workers <= 8
  ens result == (seed_index < expected_workers)
  fx pure
{
  seed_index < expected_workers
}

fn scheduler_release_gate(seed_index: u64, expected_workers: u64) -> bool
  req expected_workers > 0 && expected_workers <= 8 && seed_index < expected_workers
  ens result == (seed_index + 1 == expected_workers)
  fx pure
{
  seed_index + 1 == expected_workers
}

fn scheduler_required_ap_workers(ap_count: u64) -> u64
  req ap_count < 8
  ens (ap_count < 2 && result == ap_count) || (ap_count >= 2 && result == 2)
  fx pure
{
  let mut workers: u64 = ap_count;
  if ap_count >= 2 {
    workers = 2 as u64;
  }
  workers
}

fn scheduler_required_parallel_cpus(ap_count: u64) -> u64
  req ap_count < 8
  ens (ap_count < 2 && result == 0) || (ap_count >= 2 && result == 2)
  fx pure
{
  let mut parallel_cpus: u64 = 0;
  if ap_count >= 2 {
    parallel_cpus = 2 as u64;
  }
  parallel_cpus
}

fn scheduler_claim(counter: &Atomic) -> u64
  req true
  ens result < 4096 || result == 18446744073709551615
  fx platform(atomic)
{
  let claimed: u64 = atomic_boundary_fetch(counter, FetchOp::Add, 1, Ordering::SeqCst);
  if scheduler_task_available(claimed) {
    claimed
  } else {
    18446744073709551614 + 1
  }
}

fn scheduler_observe_max(maximum: &Atomic, candidate: u64) -> u64
  req candidate <= 8
  ens result == candidate + 1
  fx platform(atomic)
{
  let previous: u64 = atomic_boundary_fetch(maximum, FetchOp::Max, candidate, Ordering::SeqCst);
  candidate + 1
}

fn scheduler_worker_enter(
  cpu: u64,
  ready: &Atomic,
  expected_workers: &Atomic,
  task_base: &Atomic,
  task_sum: &Atomic,
  worker_mask: &Atomic,
  maximum_active: &Atomic,
  release_gate: &Atomic
) -> u64
  req cpu < 8
  ens result == cpu + 10
  fx platform(atomic)
{
  let admission_delta: u64 = 1;
  let seed_index: u64 = atomic_boundary_fetch(ready, FetchOp::Add, admission_delta, Ordering::SeqCst);
  let expected: u64 = atomic_boundary_load(expected_workers, Ordering::SeqCst);
  if expected > 0 && expected <= 8 && scheduler_seed_admitted(seed_index, expected) {
    let base: u64 = atomic_boundary_load(task_base, Ordering::SeqCst);
    if base > 0 && base <= 1000 {
      let seed_task: u64 = scheduler_task_value(base, seed_index);
      atomic_boundary_fetch(task_sum, FetchOp::Add, seed_task, Ordering::SeqCst);
    }
    let cpu_bit: u64 = ap_cpu_bit(cpu);
    atomic_boundary_fetch(worker_mask, FetchOp::Or, cpu_bit, Ordering::SeqCst);
    let active: u64 = seed_index + admission_delta;
    scheduler_observe_max(maximum_active, active);
    if scheduler_release_gate(seed_index, expected) {
      atomic_boundary_store(release_gate, admission_delta, Ordering::SeqCst);
    }
  }
  cpu + admission_delta + 9
}

fn scheduler_worker_drain(
  task_base: &Atomic,
  next_task: &Atomic,
  task_sum: &Atomic
) -> u64
  req true
  ens result <= 4097 * 5095
  fx platform(atomic)
{
  let base: u64 = atomic_boundary_load(task_base, Ordering::SeqCst);
  let mut attempts: u64 = 0;
  let mut consumed: u64 = 0;
  let mut draining: bool = base > 0 && base <= 1000;
  while attempts < 4097 && draining
    inv attempts <= 4097
    inv consumed <= attempts * 5095
    inv consumed <= 20874215
    inv !draining || (base > 0 && base <= 1000)
    dec 4097 - attempts
  {
    let task: u64 = scheduler_claim(next_task);
    if scheduler_task_available(task) {
      let task_value: u64 = scheduler_task_value(base, task);
      atomic_boundary_fetch(task_sum, FetchOp::Add, task_value, Ordering::SeqCst);
      consumed = consumed + task_value;
    } else {
      draining = false;
    }
    attempts = attempts + 1;
  }
  consumed
}

fn scheduler_expected_sum(task_base: u64) -> u64
  req task_base > 0 && task_base <= 1000
  ens result == 4096 * 4095 / 2 + 4096 * task_base
  fx pure
{
  4096 * 4095 / 2 + 4096 * task_base
}

fn scheduler_runtime_complete(
  task_sum: u64,
  expected_sum: u64,
  worker_cpus: u64,
  required_workers: u64,
  lock_entries: u64,
  expected_lock_entries: u64,
  once_owner: u64,
  parallel_cpus: u64,
  required_parallel_cpus: u64
) -> bool
  req true
  ens result == (task_sum == expected_sum && worker_cpus >= required_workers && lock_entries == expected_lock_entries && once_owner > 0 && parallel_cpus >= required_parallel_cpus)
  fx pure
{
  task_sum == expected_sum && worker_cpus >= required_workers && lock_entries == expected_lock_entries && once_owner > 0 && parallel_cpus >= required_parallel_cpus
}
