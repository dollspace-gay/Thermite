#[boundary("thermite::runtime::allocation_failure_terminal")]
fn runtime_allocation_failure_terminal(permit: EntryPermit, bytes: usize) -> TerminalReceipt
  req true
  ens result.identity == permit.identity && result.code == bytes as u64
  fx platform(boot), diverge;

#[boundary("thermite::runtime::copy_nonoverlapping")]
fn runtime_copy_nonoverlapping(
  destination: RawAddress,
  source: RawAddress,
  length: usize,
) -> MemoryTransferReceipt
  req raw_range_legal_spec(&destination, length)
    && raw_range_legal_spec(&source, length)
    && destination.region != source.region
  ens result.destination_region == destination.region
    && result.destination_offset == destination.offset
    && result.source_region == source.region
    && result.source_offset == source.offset
    && result.length == length
  fx platform(memory);

#[boundary("thermite::runtime::move_bytes")]
fn runtime_move_bytes(
  destination: RawAddress,
  source: RawAddress,
  length: usize,
) -> MemoryTransferReceipt
  req raw_range_legal_spec(&destination, length)
    && raw_range_legal_spec(&source, length)
  ens result.destination_region == destination.region
    && result.destination_offset == destination.offset
    && result.source_region == source.region
    && result.source_offset == source.offset
    && result.length == length
  fx platform(memory);

#[boundary("thermite::runtime::fill_bytes")]
fn runtime_fill_bytes(address: RawAddress, length: usize, value: u8) -> MemoryFillReceipt
  req raw_range_legal_spec(&address, length)
  ens result.region == address.region
    && result.offset == address.offset
    && result.length == length
    && result.value == value
  fx platform(memory);

