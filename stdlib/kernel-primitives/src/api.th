fn atomic_bool_swap(cell: &AtomicBool, value: bool, order: AtomicOrdering) -> AtomicBoolTransition
  req atomic_rmw_order_legal_spec(order)
  ens atomic_identity_eq_spec(&result.cell, &cell.identity) && result.next == value && result.exchanged
    && result.success_order == atomic_order_code(order) && result.failure_order == 0
  fx platform(atomic)
{
  AtomicBoolTransition {
    previous: atomic_machine_bool_swap(cell.machine_handle, value, atomic_order_to_code(&order)).0,
    next: value,
    exchanged: true,
    cell: atomic_identity_copy(&cell.identity),
    success_order: atomic_order_to_code(&order),
    failure_order: 0,
  }
}

