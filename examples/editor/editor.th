// Verified multi-line editor example (crosslink #125).
//
// Buffer edits, navigation, layout, frame construction, and key decoding verify
// at L3. Terminal mode, file access, input, and output cross the L1 boundary.
// The event loop is also L1 because it diverges. See README.md for the keymap and
// commands.

// The cursor is a byte offset into a String whose newline bytes separate lines.
// The invariant keeps the cursor in bounds and limits the buffer size.
struct Buffer {
  text: String,
  cursor: u64,
} inv cursor <= text.len() && text.len() <= 1_000_000

// Insert text at the cursor. The three `bytes_eq` conditions preserve the
// prefix, insert `ins`, and preserve the shifted suffix byte for byte (REQ-18).
fn insert_str(b: Buffer, ins: String) -> Buffer
  req b.text.len() + ins.len() <= 1_000_000
  ens result.text.len() == b.text.len() + ins.len()
  ens result.cursor == b.cursor + ins.len()
  ens bytes_eq(result.text, b.text, 0, 0, b.cursor)
  ens bytes_eq(result.text, ins, b.cursor, 0, ins.len())
  ens bytes_eq(result.text, b.text, b.cursor + ins.len(), b.cursor, b.text.len() - b.cursor)
  fx  alloc
{
  let n: u64 = ins.len();
  let head: String = b.text.slice(0, b.cursor);
  let tail: String = b.text.slice(b.cursor, b.text.len());
  Buffer { text: head.concat(ins).concat(tail), cursor: b.cursor + n }
}

// Delete the byte before the cursor. The `bytes_eq` conditions preserve the
// surrounding content rather than checking only the new length.
fn backspace(b: Buffer) -> Buffer
  req b.cursor > 0
  ens result.text.len() == b.text.len() - 1
  ens result.cursor == b.cursor - 1
  ens bytes_eq(result.text, b.text, 0, 0, b.cursor - 1)
  ens bytes_eq(result.text, b.text, b.cursor - 1, b.cursor, b.text.len() - b.cursor)
  fx  alloc
{
  let lo: u64 = b.cursor - 1;
  let head: String = b.text.slice(0, lo);
  let tail: String = b.text.slice(b.cursor, b.text.len());
  Buffer { text: head.concat(tail), cursor: lo }
}

// Move the cursor one byte left without changing the text.
fn move_left(b: Buffer) -> Buffer
  req b.cursor > 0
  ens result.cursor == b.cursor - 1
  ens result.text.len() == b.text.len()
  fx  alloc
{
  Buffer { text: b.text, cursor: b.cursor - 1 }
}

// Move the cursor one byte right without changing the text.
fn move_right(b: Buffer) -> Buffer
  req b.cursor < b.text.len()
  ens result.cursor == b.cursor + 1
  ens result.text.len() == b.text.len()
  fx  alloc
{
  Buffer { text: b.text, cursor: b.cursor + 1 }
}

// Navigation and layout use recursive scans over newline-delimited text.

// Count newline bytes in `text[i..end]`.
fn count_nl(text: &String, i: u64, end: u64) -> u64
  req i <= end && end <= text.len()
  ens result <= end - i
  ens i == end || text.byte_at(i) != 10 || result >= 1
  ens result == spec_count_nl(text, i, end)
  fx  pure
  dec end - i
{
  if i == end {
    0
  } else {
    let b: u64 = text.byte_at(i);
    if b == 10 {
      count_nl(text, i + 1, end) + 1
    } else {
      count_nl(text, i + 1, end)
    }
  }
}

// Specification counterpart to `count_nl`, used to state its exact result (#270).
spec fn spec_count_nl(text: &String, i: u64, end: u64) -> u64
  dec end - i
{
  if i >= end {
    0
  } else {
    if text.byte_at(i) == 10 {
      1 + spec_count_nl(text, i + 1, end)
    } else {
      0 + spec_count_nl(text, i + 1, end)
    }
  }
}

// Find the start of the line containing `target`. `acc` is the position after
// the most recent newline seen by the scan.
fn line_start(text: &String, i: u64, target: u64, acc: u64) -> u64
  req i <= target && target <= text.len() && acc <= i
  ens result <= target
  ens result >= acc
  ens result == spec_line_start(text, i, target, acc)
  fx  pure
  dec target - i
{
  if i == target {
    acc
  } else {
    let b: u64 = text.byte_at(i);
    if b == 10 {
      line_start(text, i + 1, target, i + 1)
    } else {
      line_start(text, i + 1, target, acc)
    }
  }
}

// Find the next newline at or after `i`, or return `n` if there is none. Passing
// `n` explicitly keeps the termination measure in specification mode.
fn line_end(text: &String, i: u64, n: u64) -> u64
  req i <= n && n == text.len()
  ens result >= i
  ens result <= n
  ens result == spec_line_end(text, i, n)
  fx  pure
  dec n - i
{
  if i == n {
    n
  } else {
    let b: u64 = text.byte_at(i);
    if b == 10 {
      i
    } else {
      line_end(text, i + 1, n)
    }
  }
}

// Specification counterpart to `line_end` (#270).
spec fn spec_line_end(text: &String, i: u64, n: u64) -> u64
  dec n - i
{
  if i >= n {
    n
  } else {
    if text.byte_at(i) == 10 {
      i
    } else {
      spec_line_end(text, i + 1, n)
    }
  }
}

// Minimum used to clamp a requested column to the destination line.
fn min2(a: u64, b: u64) -> u64
  req true
  ens result <= a
  ens result <= b
  ens result == a || result == b
  ens result == spec_min2(a, b)
  fx  pure
{
  if a <= b { a } else { b }
}

// Specification counterpart to `min2` (#270).
spec fn spec_min2(a: u64, b: u64) -> u64
  dec a
{
  if a <= b { a } else { b }
}

// Return the zero-based cursor row by counting preceding newlines.
fn cursor_row(b: &Buffer) -> u64
  req true
  ens result <= b.cursor
  ens b.cursor == 0 || b.text.byte_at(0) != 10 || result >= 1
  ens result == spec_cursor_row(&b.text, b.cursor)
  fx  pure
{
  count_nl(&b.text, 0, b.cursor)
}

// Specification counterpart to `cursor_row`; it takes text and cursor separately
// to avoid a `Buffer` dependency in the specification-function pool.
spec fn spec_cursor_row(text: &String, cursor: u64) -> u64
  dec cursor
{
  spec_count_nl(text, 0, cursor)
}

// Specification counterpart to `line_start` (#126).
spec fn spec_line_start(text: &String, i: u64, target: u64, acc: u64) -> u64
  dec target - i
{
  if i >= target {
    acc
  } else {
    if text.byte_at(i) == 10 {
      spec_line_start(text, i + 1, target, i + 1)
    } else {
      spec_line_start(text, i + 1, target, acc)
    }
  }
}

// Return the zero-based cursor column: the distance from the current line start.
fn cursor_col(b: &Buffer) -> u64
  req true
  ens result == b.cursor - spec_line_start(&b.text, 0, b.cursor, 0)
  ens result <= b.cursor
  fx  pure
{
  let ls: u64 = line_start(&b.text, 0, b.cursor, 0);
  b.cursor - ls
}

// Compute the upward-navigation target from a known line start. This helper is
// expression-only because the lowerer cannot cast-wrap a body headed by `let`.
// `0 + cursor` keeps the two branches at the same integer type.
spec fn spec_move_up_from(text: &String, cursor: u64, ls: u64) -> u64
  dec cursor
{
  if ls == 0 {
    0 + cursor
  } else {
    spec_line_start(text, 0, ls - 1, 0)
      + spec_min2(cursor - ls, (ls - 1) - spec_line_start(text, 0, ls - 1, 0))
  }
}

// Exact target for upward navigation (#270).
spec fn spec_move_up_target(text: &String, cursor: u64) -> u64
  dec cursor
{
  spec_move_up_from(text, cursor, spec_line_start(text, 0, cursor, 0))
}

// Compute the downward-navigation target from a known line end. It uses the same
// expression-only form and integer-branch convention as `spec_move_up_from`.
spec fn spec_move_down_from(text: &String, cursor: u64, n: u64, cur_end: u64) -> u64
  dec cursor
{
  if cur_end == n {
    0 + cursor
  } else {
    (cur_end + 1)
      + spec_min2(cursor - spec_line_start(text, 0, cursor, 0),
                  spec_line_end(text, cur_end + 1, n) - (cur_end + 1))
  }
}

// Exact target for downward navigation (#270).
spec fn spec_move_down_target(text: &String, cursor: u64) -> u64
  dec cursor
{
  spec_move_down_from(text, cursor, text.len(),
                      spec_line_end(text, cursor, text.len()))
}

// Move to the previous line, preserving the column when possible and clamping it
// to the previous line's length. The postcondition fixes the exact target (#270).
fn move_up(b: Buffer) -> Buffer
  req true
  ens result.text.len() == b.text.len()
  ens result.cursor <= b.cursor
  ens result.cursor == spec_move_up_target(&b.text, b.cursor)
  fx  alloc
{
  let ls: u64 = line_start(&b.text, 0, b.cursor, 0);
  if ls == 0 {
    b
  } else {
    let col: u64 = b.cursor - ls;
    let prev_nl: u64 = ls - 1;
    let prev_ls: u64 = line_start(&b.text, 0, prev_nl, 0);
    let prev_len: u64 = prev_nl - prev_ls;
    let want: u64 = prev_ls + min2(col, prev_len);
    Buffer { text: b.text, cursor: want }
  }
}

// Move to the next line, preserving the column when possible and clamping it to
// the next line's length. The postcondition fixes the exact target (#270).
fn move_down(b: Buffer) -> Buffer
  req true
  ens result.text.len() == b.text.len()
  ens result.cursor <= b.text.len()
  ens result.cursor == spec_move_down_target(&b.text, b.cursor)
  fx  alloc
{
  let n: u64 = b.text.len();
  let ls: u64 = line_start(&b.text, 0, b.cursor, 0);
  let col: u64 = b.cursor - ls;
  let cur_end: u64 = line_end(&b.text, b.cursor, n);
  if cur_end == n {
    b
  } else {
    let next_ls: u64 = cur_end + 1;
    let next_end: u64 = line_end(&b.text, next_ls, n);
    let next_len: u64 = next_end - next_ls;
    let want: u64 = next_ls + min2(col, next_len);
    Buffer { text: b.text, cursor: want }
  }
}

// Convert a zero-based coordinate to ANSI's one-based coordinate system.
fn to_1based(x: u64) -> u64
  req x < 1_000_000
  ens result == x + 1
  fx  pure
{
  x + 1
}

// Build the ANSI clear-screen frame, append the buffer, and position the cursor.
// The buffer begins at byte 7 after the fixed clear sequence, so `bytes_eq`
// verifies the complete payload (REQ-18, AC-15). The variable-length coordinate
// suffix is covered by its component contracts rather than a fixed byte window.
fn render_frame(b: &Buffer) -> String
  req b.text.len() <= 900_000
  ens result.len() >= b.text.len()
  ens bytes_eq(result, b.text, 7, 0, b.text.len())
  fx  alloc
{
  let clear: String = "\x1b[2J\x1b[H";
  let row: String = to_1based(cursor_row(b)).to_string();
  let col: String = to_1based(cursor_col(b)).to_string();
  let pos: String = "\x1b[".concat(row).concat(";").concat(col).concat("H");
  let body: String = b.text.slice(0, b.text.len());
  clear.concat(body).concat(pos)
}

// Decode a keystroke into the editor's internal key code. Printable bytes and
// Ctrl-S/Ctrl-Q retain their values; arrows map to 1000–1003, Enter maps to
// 1004, and unsupported input maps to zero.
fn decode(b0: u64, b1: u64, b2: u64) -> u64
  req true
  ens b0 < 32 || b0 > 126 || b0 == 27 || result == b0
  ens b0 != 127 || result == 127
  ens b0 != 17 || result == 17
  ens b0 != 19 || result == 19
  ens b0 != 13 || result == 1004
  ens b0 != 10 || result == 1004
  ens b0 != 27 || b1 != 91 || b2 != 65 || result == 1000
  ens b0 != 27 || b1 != 91 || b2 != 66 || result == 1001
  ens b0 != 27 || b1 != 91 || b2 != 67 || result == 1002
  ens b0 != 27 || b1 != 91 || b2 != 68 || result == 1003
  ens result <= 1004
  fx  pure
{
  if b0 == 27 {
    if b1 == 91 {
      if b2 >= 65 {
        if b2 <= 68 {
          1000 + (b2 - 65)
        } else {
          0
        }
      } else {
        0
      }
    } else {
      0
    }
  } else {
    if b0 == 13 {
      1004
    } else {
      if b0 == 10 {
        1004
      } else {
        if b0 >= 32 {
          if b0 <= 126 {
            b0
          } else {
            if b0 == 127 {
              127
            } else {
              0
            }
          }
        } else {
          if b0 == 17 {
            17
          } else {
            if b0 == 19 {
              19
            } else {
              if b0 == 127 {
                127
              } else {
                0
              }
            }
          }
        }
      }
    }
  }
}

// Put the terminal into raw mode via extern-C tcgetattr/tcsetattr (libc through
// std). Status is zero for success or a non-TTY no-op and one for error. The
// boundary is limited to the `term` effect and ioctl syscall (#57, REQ-7).
#[boundary("os::raw_mode_on")] fn raw_mode_on() -> u64
  req true
  ens result <= 1
  fx  term
  ;

// Restore the terminal's original mode.
#[boundary("os::raw_mode_off")] fn raw_mode_off() -> u64
  req true
  ens result <= 1
  fx  term
  ;

// Read one keystroke, returning the raw bytes packed into a u64 for `decode`: b0 in
// bits 0..9, b1 in 9..18, b2 in 18..27. A plain key reads 1 byte; an ESC reads the
// two-byte arrow tail. The packed maximum fits in 27 bits.
#[boundary("os::read_key_raw")] fn read_key_raw() -> u64
  req true
  ens result <= 134_217_727
  fx  read(input)
  ;

// Write the rendered frame String to stdout (and flush). Returns a status u64 (0 =
// ok, 1 = I/O error).
#[boundary("os::write_frame")] fn write_frame(s: String) -> u64
  req true
  ens result <= 1
  fx  write(output)
  ;

// Load the initial buffer from `THERMITE_EDITOR_FILE`, or from
// `/tmp/thermite_editor.txt` if the variable is unset. A missing file produces
// an empty buffer.
#[boundary("os::read_file")] fn read_file() -> String
  req true
  ens result.len() <= 1_000_000
  fx  read(input)
  ;

// Save the buffer, including newline bytes, to the configured editor file.
#[boundary("os::write_file")] fn write_file(content: String) -> u64
  req true
  ens result <= 1
  fx  write(output)
  ;

// Run the interactive loop until Ctrl-Q, saving on Ctrl-S. This function is L1
// because it performs boundary I/O and carries the `diverge` effect.
fn run() -> u64
  req true
  ens result <= 1
  fx  read(input), write(output), alloc, diverge, term
{
  let entered: u64 = raw_mode_on();
  let loaded: String = read_file();
  let mut b: Buffer = Buffer { text: loaded, cursor: 0 };
  let first: String = render_frame(&b);
  let shown0: u64 = write_frame(first);
  while true
    inv b.text.len() <= 900_000
    dec 1
  {
    let packed: u64 = read_key_raw();
    let b0: u64 = packed % 512;
    let b1: u64 = (packed / 512) % 512;
    let b2: u64 = (packed / 262_144) % 512;
    let k: u64 = decode(b0, b1, b2);
    if k == 17 {
      break;
    }
    if k == 19 {
      let snapshot: String = b.text.slice(0, b.text.len());
      let saved: u64 = write_file(snapshot);
    }
    if k == 127 {
      if b.cursor > 0 { b = backspace(b); }
    }
    if k == 1003 {
      if b.cursor > 0 { b = move_left(b); }
    }
    if k == 1002 {
      if b.cursor < b.text.len() { b = move_right(b); }
    }
    if k == 1000 {
      b = move_up(b);
    }
    if k == 1001 {
      b = move_down(b);
    }
    if k == 1004 {
      if b.text.len() + 1 <= 900_000 { b = insert_str(b, "\n"); }
    }
    if k >= 32 {
      if k <= 126 {
        if b.text.len() + 1 <= 900_000 { b = insert_str(b, String::from_byte(k)); }
      }
    }
    let frame: String = render_frame(&b);
    let shown: u64 = write_frame(frame);
  }
  let restored: u64 = raw_mode_off();
  0
}
