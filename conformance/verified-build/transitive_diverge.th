fn transitive_diverging(x: u64) -> u64
  req true
  ens result == x
  fx diverge
{ transitive_diverging(x) }

fn diverge_middle(x: u64) -> u64
  req true
  ens result == x
  fx diverge
{ transitive_diverging(x) }

fn transitive_diverge_root(x: u64) -> u64
  req true
  ens result == x
  fx diverge
{ diverge_middle(x) }
