#[sealed("atomic_bool_init")] struct AtomicBool { identity: AtomicIdentity, machine_handle: usize }
#[sealed("atomic_u32_init")] struct AtomicU32 { identity: AtomicIdentity, machine_handle: usize }
#[sealed("atomic_u64_init")] struct AtomicU64 { identity: AtomicIdentity, machine_handle: usize }
#[sealed("atomic_usize_init")] struct AtomicUsize { identity: AtomicIdentity, machine_handle: usize }

struct AtomicBoolObservation {
  value: bool,
  cell: AtomicIdentity,
  order: u8,
}

struct AtomicU32Observation {
  value: u32,
  cell: AtomicIdentity,
  order: u8,
}

struct AtomicU64Observation {
  value: u64,
  cell: AtomicIdentity,
  order: u8,
}

struct AtomicUsizeObservation {
  value: usize,
  cell: AtomicIdentity,
  order: u8,
}

struct AtomicBoolTransition {
  previous: bool,
  next: bool,
  exchanged: bool,
  cell: AtomicIdentity,
  success_order: u8,
  failure_order: u8,
}

struct AtomicU32Transition {
  previous: u32,
  next: u32,
  exchanged: bool,
  cell: AtomicIdentity,
  success_order: u8,
  failure_order: u8,
}

struct AtomicU64Transition {
  previous: u64,
  next: u64,
  exchanged: bool,
  cell: AtomicIdentity,
  success_order: u8,
  failure_order: u8,
}

struct AtomicUsizeTransition {
  previous: usize,
  next: usize,
  exchanged: bool,
  cell: AtomicIdentity,
  success_order: u8,
  failure_order: u8,
}

struct AtomicWrite {
  cell: AtomicIdentity,
  width: u8,
  order: u8,
  value: u64,
}

struct AtomicFence {
  kind: u8,
  order: u8,
}

fn atomic_bool_rmw_result(
  cell: &AtomicBool,
  previous: bool,
  next: bool,
  order: AtomicOrdering,
) -> AtomicBoolTransition
  req true
  ens atomic_identity_eq_spec(&result.cell, &cell.identity)
    && result.previous == previous && result.next == next && result.exchanged
    && result.success_order == atomic_order_code(order) && result.failure_order == 0
  fx pure
{
  AtomicBoolTransition {
    previous: previous,
    next: next,
    exchanged: true,
    cell: atomic_identity_copy(&cell.identity),
    success_order: atomic_order_to_code(&order),
    failure_order: 0,
  }
}

