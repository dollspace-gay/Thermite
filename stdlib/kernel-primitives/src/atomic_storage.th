fn atomic_bool_storage_after_claim(
  ledger: StaticStorageLedger,
  lease: StaticStorageLease,
  fill: u8,
  initial: bool,
) -> bool
  req static_storage_lease_live_spec(&ledger, &lease)
    && static_storage_lease_capacity_spec(&lease) >= ATOMIC_BOOL_STORAGE_BYTES
  ens result
  fx platform(memory), platform(atomic)
{
  let authority: usize = static_storage_lease_authority(&lease);
  let storage_slot: usize = static_storage_lease_slot(&lease);
  let generation: u64 = static_storage_lease_generation(&lease);
  let witness: StaticStorageInitWitness = static_storage_fill_bytes(&lease, fill);
  match static_storage_commit(ledger, lease, witness) {
    StaticStorageCommit::Initialized {
      ledger: _,
      region,
    } => atomic_bool_region_init(
      region,
      authority,
      storage_slot,
      generation,
      initial,
    ),
    StaticStorageCommit::CommitRejected {
      ledger: _,
      lease: _,
      witness: _,
      reason: _,
    } => false,
  }
}

