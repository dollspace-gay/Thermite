#[sealed] struct Clock { slot: u64 }

struct Instant {
  ticks: u64,
  scale_numerator: u64,
  scale_denominator: u64,
  error_ticks: u64
}
  inv scale_numerator > 0 && scale_denominator > 0

#[boundary("kernel::clock::read@v1")]
fn clock_read(clock: Clock) -> Instant
  req true
  ens result.scale_numerator > 0
  ens result.scale_denominator > 0
  fx platform(clock)
;
