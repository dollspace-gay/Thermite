#[sealed] struct AtomicBool { identity: AtomicIdentity }
#[sealed] struct AtomicU32 { identity: AtomicIdentity }
#[sealed] struct AtomicU64 { identity: AtomicIdentity }
#[sealed] struct AtomicUsize { identity: AtomicIdentity }

struct AtomicBoolObservation {
  value: bool,
  cell: AtomicIdentity,
  order: u8,
}

struct AtomicU32Observation {
  value: u32,
  cell: AtomicIdentity,
  order: u8,
}

struct AtomicU64Observation {
  value: u64,
  cell: AtomicIdentity,
  order: u8,
}

struct AtomicUsizeObservation {
  value: usize,
  cell: AtomicIdentity,
  order: u8,
}

struct AtomicBoolTransition {
  previous: bool,
  next: bool,
  exchanged: bool,
  cell: AtomicIdentity,
  success_order: u8,
  failure_order: u8,
}

struct AtomicU32Transition {
  previous: u32,
  next: u32,
  exchanged: bool,
  cell: AtomicIdentity,
  success_order: u8,
  failure_order: u8,
}

struct AtomicU64Transition {
  previous: u64,
  next: u64,
  exchanged: bool,
  cell: AtomicIdentity,
  success_order: u8,
  failure_order: u8,
}

struct AtomicUsizeTransition {
  previous: usize,
  next: usize,
  exchanged: bool,
  cell: AtomicIdentity,
  success_order: u8,
  failure_order: u8,
}

struct AtomicWrite {
  cell: AtomicIdentity,
  width: u8,
  order: u8,
  value: u64,
}

struct AtomicFence {
  kind: u8,
  order: u8,
}

#[boundary("thermite::atomic::bool::init")]
fn atomic_bool_init(slot: AtomicBoolSlot, initial: bool) -> AtomicBool
  req true
  ens atomic_bool_slot_identity_matches_spec(&slot, &result.identity)
  fx platform(atomic);

