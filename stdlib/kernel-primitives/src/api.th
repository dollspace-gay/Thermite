fn atomic_bool_compare_exchange_weak(
  cell: &AtomicBool,
  current: bool,
  value: bool,
  success: AtomicOrdering,
  failure: AtomicOrdering,
) -> AtomicBoolTransition
  req atomic_cas_order_legal_spec(success, failure)
  ens atomic_identity_eq_spec(&result.cell, &cell.identity)
    && result.success_order == atomic_order_code(success)
    && result.failure_order == atomic_order_code(failure)
    && (!result.exchanged || result.previous == current)
    && result.next == if result.exchanged { value } else { result.previous }
  fx platform(atomic)
{
  let transition: (bool, bool, usize) = atomic_machine_bool_compare_exchange_weak(
    cell.machine_handle,
    current,
    value,
    atomic_order_to_code(&success),
    atomic_order_to_code(&failure),
  );
  AtomicBoolTransition {
    previous: transition.0,
    next: if transition.1 { value } else { transition.0 },
    exchanged: transition.1,
    cell: atomic_identity_copy(&cell.identity),
    success_order: atomic_order_to_code(&success),
    failure_order: atomic_order_to_code(&failure),
  }
}

