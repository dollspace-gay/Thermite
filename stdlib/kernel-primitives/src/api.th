fn atomic_bool_init(slot: AtomicBoolSlot, initial: bool) -> AtomicBool
  req true
  ens atomic_bool_slot_identity_matches_spec(&slot, &result.identity)
  fx platform(atomic)
{
  let identity: (usize, usize, u64) = atomic_bool_slot_identity_values(&slot);
  let handle: usize = atomic_machine_bool_init(identity.0, identity.1, identity.2, initial).0;
  AtomicBool {
    identity: AtomicIdentity { authority: identity.0, slot: identity.1, generation: identity.2 },
    machine_handle: handle,
  }
}

